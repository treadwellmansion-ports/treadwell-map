# Supabase -- from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# No map provider keys needed -- the map runs on MapLibre GL JS + OpenFreeMap
# (free vector tiles, no account), geocoding runs on Nominatim (OpenStreetMap),
# and walking-distance calculations run on OSRM's public routing server.
# All three are free, keyless, fair-use public services. See README for
# details and self-hosting notes if usage ever needs to grow beyond that.

# Resend -- powers the guest "send my cart" email and the staff notification
# email. Sign up at resend.com (free tier, no card required to start), grab
# an API key from the dashboard, and verify a sending domain there before
# guest-facing email will actually deliver to arbitrary addresses (Resend's
# unverified/test mode only delivers to the account owner's own address).
RESEND_API_KEY=re_your-api-key
# Must be an address on a domain you've verified in Resend (e.g.
# concierge@thetreadwellmansion.com). Falls back to Resend's shared test
# address (onboarding@resend.dev) if unset -- fine for local testing, but
# guest email won't deliver in production until a domain is verified.
CART_FROM_EMAIL=onboarding@resend.dev
# Where the "a guest sent themselves a cart" staff notification goes.
CART_NOTIFICATION_EMAIL=you@example.com
