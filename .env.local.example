# Supabase -- from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# No map provider keys needed -- the map runs on MapLibre GL JS + OpenFreeMap
# (free vector tiles, no account), geocoding runs on Nominatim (OpenStreetMap),
# and walking-distance calculations run on OSRM's public routing server.
# All three are free, keyless, fair-use public services. See README for
# details and self-hosting notes if usage ever needs to grow beyond that.
